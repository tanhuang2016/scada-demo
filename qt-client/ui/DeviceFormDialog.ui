       <item row="6" column="1"><widget class="QSpinBox" name="editPort"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>5001</number></property></widget></item>
       <item row="7" column="0"><widget class="QLabel" name="lblProtocol"><property name="text"><string>协议</string></property></widget></item>
       <item row="7" column="1"><widget class="QComboBox" name="comboProtocol"><item><property name="text"><string>JSON</string></property></item><item><property name="text"><string>IEC104</string></property></item></widget></item>
       <item row="8" column="0"><widget class="QLabel" name="lblCA"><property name="text"><string>公共地址</string></property></widget></item>
       <item row="8" column="1"><widget class="QSpinBox" name="editCA"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property></widget></item>
       <item row="9" column="0"><widget class="QLabel" name="lblEnabled"><property name="text"><string>启用</string></property></widget></item>
       <item row="9" column="1"><widget class="QCheckBox" name="checkEnabled"><property name="checked"><bool>true</bool></property></widget></item>
